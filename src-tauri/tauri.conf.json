{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "星航日志",
  "version": "1.0.0",
  "identifier": "com.starlog.knowledge-guide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "星航日志 · 秋招知识星图",
        "width": 1360,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEODY3RTY5QTYwMDY3OTQKUldTVVp3Q21hWDZHclM3TVlVdkdRcndMcUtYVElEd2xsUzByY0NxamVWVVFFRUFXM2kwaEo0WWQK",
      "endpoints": [
        "https://blazingout.github.io/knowledge-guide/latest.json"
      ]
    }
  }
}
