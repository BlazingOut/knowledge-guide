{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "星航日志主窗口默认权限：核心能力 + 自动更新检查/下载/重启 + 备份文件读写",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file"
  ]
}
